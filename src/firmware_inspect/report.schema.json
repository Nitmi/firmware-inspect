{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Firmware Inspect structured CLI reports v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "operation", "scope", "hardware_access", "executables_started", "flash_authorized"],
  "properties": {
    "schema_version": {"enum": ["embedded-firmware-inspect.inspection.v1", "embedded-firmware-inspect.diff.v1", "embedded-firmware-inspect.symbols.v1", "embedded-firmware-inspect.addresses.v1", "embedded-firmware-inspect.error.v1"]},
    "ok": {"type": "boolean"},
    "operation": {"enum": ["inspect", "diff", "symbols", "addresses"]},
    "scope": {"const": "host_only_firmware_analysis"},
    "hardware_access": {"const": false},
    "executables_started": {"const": false},
    "flash_authorized": {"const": false},
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "firmware-inspect"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "source": {"$ref": "#/$defs/source"},
    "before": {"$ref": "#/$defs/source"},
    "after": {"$ref": "#/$defs/source"},
    "format": {"enum": ["elf", "hex", "bin"]},
    "address_unit": {"const": "byte"},
    "range_convention": {"const": "half_open"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "value_semantics": {"const": "elf_st_value"},
    "complete": {"const": true},
    "symbol_tables_scanned": {"type": "integer", "minimum": 0, "maximum": 4096},
    "symbol_entries_scanned": {"type": "integer", "minimum": 0, "maximum": 200000},
    "queries": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/symbol_query"}},
    "address_mode": {"enum": ["raw", "arm-thumb"]},
    "address_queries": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/address_query"}},
    "debug_lines": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "compile_units_scanned", "line_programs_scanned", "line_entries_scanned"],
      "properties": {
        "status": {"enum": ["disabled", "absent", "scanned"]},
        "compile_units_scanned": {"type": "integer", "minimum": 0, "maximum": 1024},
        "line_programs_scanned": {"type": "integer", "minimum": 0, "maximum": 1024},
        "line_entries_scanned": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "entry_point": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
    "hex_start_address": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["EIP"], "properties": {"EIP": {"$ref": "#/$defs/address"}}},
        {"type": "object", "additionalProperties": false, "required": ["CS", "IP"], "properties": {"CS": {"type": "integer", "minimum": 0, "maximum": 65535}, "IP": {"type": "integer", "minimum": 0, "maximum": 65535}}}
      ]
    },
    "build_ids": {"oneOf": [{"$ref": "#/$defs/build_ids"}, {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"$ref": "#/$defs/build_ids"}, "after": {"$ref": "#/$defs/build_ids"}}}]},
    "sections": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/section"}},
    "load_segments": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/segment"}},
    "symbols": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["defined_function_object_entries", "limit", "truncated", "largest"],
          "properties": {
            "defined_function_object_entries": {"type": "integer", "minimum": 0, "maximum": 200000},
            "limit": {"type": "integer", "minimum": 0, "maximum": 200},
            "truncated": {"type": "boolean"},
            "largest": {
              "type": "array", "maxItems": 200,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "type", "address", "size_bytes", "section_index", "table_index"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 1024},
                  "type": {"enum": ["STT_FUNC", "STT_OBJECT"]},
                  "address": {"$ref": "#/$defs/address"},
                  "size_bytes": {"type": "integer", "minimum": 0},
                  "section_index": {"type": "integer", "minimum": 1},
                  "table_index": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      ]
    },
    "programmed_ranges": {"oneOf": [{"$ref": "#/$defs/ranges"}, {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"$ref": "#/$defs/ranges"}, "after": {"$ref": "#/$defs/ranges"}}}]},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["program_address_bytes", "load_file_bytes_sum", "section_usage"],
      "properties": {
        "program_address_bytes": {"type": "integer", "minimum": 0},
        "load_file_bytes_sum": {"type": "integer", "minimum": 0},
        "section_usage": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]}
      }
    },
    "source_identical": {"type": "boolean"},
    "identical": {"type": "boolean"},
    "file_size_delta_bytes": {"type": "integer"},
    "program_address_delta_bytes": {"type": "integer"},
    "entry_point_changed": {"type": "boolean"},
    "layout_changed": {"type": "boolean"},
    "section_usage_delta": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]},
    "section_changes": {
      "type": "array", "maxItems": 8192,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "occurrence", "change", "before", "after", "size_delta_bytes"],
        "properties": {
          "name": {"type": "string", "maxLength": 1024},
          "occurrence": {"type": "integer", "minimum": 0},
          "change": {"enum": ["added", "removed", "changed"]},
          "before": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/section"}]},
          "after": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/section"}]},
          "size_delta_bytes": {"type": "integer"}
        }
      }
    },
    "load_segment_changes": {
      "type": "array", "maxItems": 8192,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["load_address", "run_address", "occurrence", "change", "before", "after"],
        "properties": {
          "load_address": {"$ref": "#/$defs/address"},
          "run_address": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
          "occurrence": {"type": "integer", "minimum": 0},
          "change": {"enum": ["added", "removed", "changed"]},
          "before": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/segment_content"}]},
          "after": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/segment_content"}]}
        }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"enum": ["INPUT_INVALID", "INPUT_UNAVAILABLE", "LIMIT_EXCEEDED", "OPTIONS_INVALID", "FORMAT_INVALID", "FORMAT_UNKNOWN", "FORMAT_UNSUPPORTED", "INPUT_INCOMPATIBLE"]},
        "message": {"type": "string"}, "retryable": {"const": false}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {"const": "embedded-firmware-inspect.inspection.v1"}, "ok": {"const": true}, "operation": {"const": "inspect"}, "build_ids": {"$ref": "#/$defs/build_ids"}, "programmed_ranges": {"$ref": "#/$defs/ranges"},
        "before": false, "after": false, "source_identical": false, "identical": false,
        "file_size_delta_bytes": false, "program_address_delta_bytes": false,
        "entry_point_changed": false, "layout_changed": false, "section_usage_delta": false,
        "section_changes": false, "load_segment_changes": false, "error": false,
        "queries": false, "value_semantics": false, "complete": false,
        "address_mode": false, "address_queries": false, "debug_lines": false,
        "symbol_tables_scanned": false, "symbol_entries_scanned": false
      },
      "required": ["tool", "warnings", "source", "format", "address_unit", "range_convention", "architecture", "entry_point", "build_ids", "sections", "load_segments", "symbols", "programmed_ranges", "summary"]
    },
    {
      "properties": {
        "schema_version": {"const": "embedded-firmware-inspect.diff.v1"}, "ok": {"const": true}, "operation": {"const": "diff"}, "build_ids": {"type": "object"}, "programmed_ranges": {"type": "object"},
        "source": false, "address_unit": false, "range_convention": false, "entry_point": false,
        "hex_start_address": false, "sections": false, "load_segments": false, "symbols": false,
        "summary": false, "error": false,
        "address_mode": false, "address_queries": false, "debug_lines": false,
        "queries": false, "value_semantics": false, "complete": false,
        "symbol_tables_scanned": false, "symbol_entries_scanned": false
      },
      "required": ["tool", "warnings", "before", "after", "format", "architecture", "source_identical", "identical", "file_size_delta_bytes", "program_address_delta_bytes", "entry_point_changed", "build_ids", "layout_changed", "programmed_ranges", "section_usage_delta", "section_changes", "load_segment_changes"]
    },
    {
      "properties": {
        "schema_version": {"const": "embedded-firmware-inspect.symbols.v1"},
        "ok": {"const": true}, "operation": {"const": "symbols"},
        "format": {"const": "elf"}, "architecture": {"type": "object"},
        "before": false, "after": false, "address_unit": false, "range_convention": false,
        "entry_point": false, "hex_start_address": false, "build_ids": false, "sections": false,
        "load_segments": false, "symbols": false, "programmed_ranges": false, "summary": false,
        "source_identical": false, "identical": false, "file_size_delta_bytes": false,
        "program_address_delta_bytes": false, "entry_point_changed": false, "layout_changed": false,
        "section_usage_delta": false, "section_changes": false, "load_segment_changes": false,
        "error": false,
        "address_mode": false, "address_queries": false, "debug_lines": false
      },
      "required": ["tool", "warnings", "source", "format", "architecture", "queries", "value_semantics", "complete", "symbol_tables_scanned", "symbol_entries_scanned"]
    },
    {
      "properties": {
        "schema_version": {"const": "embedded-firmware-inspect.addresses.v1"},
        "ok": {"const": true}, "operation": {"const": "addresses"},
        "format": {"const": "elf"}, "architecture": {"type": "object"},
        "before": false, "after": false, "queries": false, "value_semantics": false,
        "entry_point": false, "hex_start_address": false, "build_ids": false, "sections": false,
        "load_segments": false, "symbols": false, "programmed_ranges": false, "summary": false,
        "source_identical": false, "identical": false, "file_size_delta_bytes": false,
        "program_address_delta_bytes": false, "entry_point_changed": false, "layout_changed": false,
        "section_usage_delta": false, "section_changes": false, "load_segment_changes": false,
        "error": false
      },
      "required": ["tool", "warnings", "source", "format", "architecture", "address_unit", "range_convention", "address_mode", "address_queries", "debug_lines", "complete", "symbol_tables_scanned", "symbol_entries_scanned"]
    },
    {
      "properties": {
        "schema_version": {"const": "embedded-firmware-inspect.error.v1"}, "ok": {"const": false},
        "tool": false, "warnings": false, "source": false, "before": false, "after": false,
        "format": false, "address_unit": false, "range_convention": false, "architecture": false,
        "entry_point": false, "hex_start_address": false, "build_ids": false, "sections": false,
        "load_segments": false, "symbols": false, "programmed_ranges": false, "summary": false,
        "source_identical": false, "identical": false, "file_size_delta_bytes": false,
        "program_address_delta_bytes": false, "entry_point_changed": false, "layout_changed": false,
        "section_usage_delta": false, "section_changes": false, "load_segment_changes": false,
        "queries": false, "value_semantics": false, "complete": false,
        "address_mode": false, "address_queries": false, "debug_lines": false,
        "symbol_tables_scanned": false, "symbol_entries_scanned": false
      },
      "required": ["error"]
    }
  ],
  "$defs": {
    "address_function": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "table_index", "table_name", "symbol_index", "section_index", "binding", "visibility", "raw_value", "range_start", "range_end_exclusive", "size_bytes", "offset_bytes", "match_kind", "value_normalization"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "table_index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "table_name": {"type": "string", "maxLength": 1024},
        "symbol_index": {"type": "integer", "minimum": 0, "maximum": 199999},
        "section_index": {"type": "integer", "minimum": 1, "maximum": 4095},
        "binding": {"type": ["string", "integer"], "maxLength": 32},
        "visibility": {"type": ["string", "integer"], "maxLength": 32},
        "raw_value": {"$ref": "#/$defs/address"}, "range_start": {"$ref": "#/$defs/address"},
        "range_end_exclusive": {"type": ["null", "integer"], "minimum": 0, "maximum": 18446744073709551616},
        "size_bytes": {"$ref": "#/$defs/address"}, "offset_bytes": {"$ref": "#/$defs/address"},
        "match_kind": {"enum": ["declared_range", "exact_start_only"]},
        "value_normalization": {"enum": ["none", "arm_thumb_bit"]}
      },
      "allOf": [{
        "if": {"properties": {"match_kind": {"const": "exact_start_only"}}},
        "then": {"properties": {"size_bytes": {"const": 0}, "range_end_exclusive": {"const": null}, "offset_bytes": {"const": 0}}},
        "else": {"properties": {"size_bytes": {"minimum": 1}, "range_end_exclusive": {"type": "integer", "minimum": 1}}}
      }]
    },
    "address_line": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "directory", "compilation_directory", "line", "column", "discriminator", "is_statement", "cu_offset", "line_program_offset", "entry_index", "dwarf_version", "range_start", "range_end_exclusive"],
      "properties": {
        "file_name": {"type": ["string", "null"], "maxLength": 4096},
        "directory": {"type": ["string", "null"], "maxLength": 4096},
        "compilation_directory": {"type": ["string", "null"], "maxLength": 4096},
        "line": {"type": "integer", "minimum": 1}, "column": {"type": "integer", "minimum": 0},
        "discriminator": {"type": "integer", "minimum": 0}, "is_statement": {"type": "boolean"},
        "cu_offset": {"type": "integer", "minimum": 0}, "line_program_offset": {"type": "integer", "minimum": 0},
        "entry_index": {"type": "integer", "minimum": 0}, "dwarf_version": {"enum": [2, 3, 4, 5]},
        "range_start": {"$ref": "#/$defs/address"}, "range_end_exclusive": {"type": "integer", "minimum": 1, "maximum": 18446744073709551616}
      }
    },
    "address_query": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "lookup_address", "function_status", "functions", "line_status", "lines"],
      "properties": {
        "address": {"$ref": "#/$defs/address"}, "lookup_address": {"$ref": "#/$defs/address"},
        "function_status": {"enum": ["unique", "ambiguous", "not_found"]},
        "functions": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/address_function"}},
        "line_status": {"enum": ["unique", "ambiguous", "not_found"]},
        "lines": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/address_line"}}
      },
      "allOf": [
        {"if": {"properties": {"function_status": {"const": "not_found"}}}, "then": {"properties": {"functions": {"maxItems": 0}}}, "else": {"properties": {"functions": {"minItems": 1}}}},
        {"if": {"properties": {"function_status": {"const": "ambiguous"}}}, "then": {"properties": {"functions": {"minItems": 2}}}},
        {"if": {"properties": {"line_status": {"const": "not_found"}}}, "then": {"properties": {"lines": {"maxItems": 0}}}, "else": {"properties": {"lines": {"minItems": 1}}}},
        {"if": {"properties": {"line_status": {"const": "ambiguous"}}}, "then": {"properties": {"lines": {"minItems": 2}}}}
      ]
    },
    "symbol_match": {
      "type": "object", "additionalProperties": false,
      "required": ["table_index", "table_name", "symbol_index", "type", "binding", "visibility", "value", "value_kind", "size_bytes", "definition", "section_index", "section"],
      "properties": {
        "table_index": {"type": "integer", "minimum": 0, "maximum": 4095},
        "table_name": {"type": "string", "maxLength": 1024},
        "symbol_index": {"type": "integer", "minimum": 0, "maximum": 199999},
        "type": {"type": ["string", "integer"], "maxLength": 32},
        "binding": {"type": ["string", "integer"], "maxLength": 32},
        "visibility": {"type": ["string", "integer"], "maxLength": 32},
        "value": {"$ref": "#/$defs/address"}, "size_bytes": {"$ref": "#/$defs/address"},
        "value_kind": {"enum": ["linker_virtual_value", "absolute_value", "common_alignment", "undefined_value", "special_value", "tls_offset"]},
        "definition": {"enum": ["section", "absolute", "common", "undefined", "reserved"]},
        "section_index": {"type": ["string", "integer"], "maxLength": 32, "minimum": 0},
        "section": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/section"}]}
      }
    },
    "symbol_query": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "matched_entries", "definition_count", "value", "matches"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "status": {"enum": ["unique", "ambiguous", "not_found", "undefined_only", "no_definition"]},
        "matched_entries": {"type": "integer", "minimum": 0, "maximum": 256},
        "definition_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "value": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "matches": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/symbol_match"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unique"}}},
          "then": {"properties": {"definition_count": {"const": 1}, "value": {"$ref": "#/$defs/address"}, "matched_entries": {"minimum": 1}, "matches": {"minItems": 1}}},
          "else": {"properties": {"value": {"const": null}}}
        },
        {
          "if": {"properties": {"status": {"const": "ambiguous"}}},
          "then": {"properties": {"definition_count": {"minimum": 2}, "matched_entries": {"minimum": 2}, "matches": {"minItems": 2}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_found"}}},
          "then": {"properties": {"definition_count": {"const": 0}, "matched_entries": {"const": 0}, "matches": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["undefined_only", "no_definition"]}}},
          "then": {"properties": {"definition_count": {"const": 0}, "matched_entries": {"minimum": 1}, "matches": {"minItems": 1}}}
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "address": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "architecture": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["machine", "bits", "endianness", "elf_type"], "properties": {"machine": {"type": ["string", "integer"]}, "bits": {"enum": [32, 64]}, "endianness": {"enum": ["little", "big"]}, "elf_type": {"enum": ["ET_EXEC", "ET_DYN"]}}}
      ]
    },
    "build_ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "maxLength": 8192, "pattern": "^[0-9a-f]*$"}},
    "ranges": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["start", "end_exclusive", "length_bytes"],
        "properties": {"start": {"$ref": "#/$defs/address"}, "end_exclusive": {"type": "integer", "minimum": 1, "maximum": 18446744073709551616}, "length_bytes": {"type": "integer", "minimum": 1}}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "load_address", "run_address", "source_offset", "file_size_bytes", "memory_size_bytes", "sha256"],
      "properties": {
        "index": {"type": "integer", "minimum": 0}, "load_address": {"$ref": "#/$defs/address"},
        "run_address": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "source_offset": {"type": ["integer", "null"], "minimum": 0},
        "file_size_bytes": {"type": "integer", "minimum": 0},
        "memory_size_bytes": {"type": ["integer", "null"], "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "address", "size_bytes", "allocated", "writable", "executable", "file_backed", "sha256"],
      "properties": {
        "index": {"type": "integer", "minimum": 0}, "name": {"type": "string", "maxLength": 1024},
        "type": {"type": ["string", "integer"]}, "address": {"$ref": "#/$defs/address"},
        "size_bytes": {"type": "integer", "minimum": 0}, "allocated": {"type": "boolean"},
        "writable": {"type": "boolean"}, "executable": {"type": "boolean"}, "file_backed": {"type": "boolean"},
        "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "segment_content": {
      "type": "object", "additionalProperties": false,
      "required": ["load_address", "run_address", "file_size_bytes", "memory_size_bytes", "sha256"],
      "properties": {
        "load_address": {"$ref": "#/$defs/address"},
        "run_address": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]},
        "file_size_bytes": {"type": "integer", "minimum": 0},
        "memory_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["allocated_bytes_sum", "file_backed_bytes_sum", "zero_fill_bytes_sum", "writable_bytes_sum", "readonly_bytes_sum", "executable_bytes_sum"],
      "properties": {
        "allocated_bytes_sum": {"type": "integer"}, "file_backed_bytes_sum": {"type": "integer"},
        "zero_fill_bytes_sum": {"type": "integer"}, "writable_bytes_sum": {"type": "integer"},
        "readonly_bytes_sum": {"type": "integer"}, "executable_bytes_sum": {"type": "integer"}
      }
    }
  }
}
